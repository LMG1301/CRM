{
  "manifest_version": 3,
  "name": "Boost CRM",
  "version": "3.0.0",
  "description": "Assistant commercial IA avec contexte CRM",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["linkedin-scraper.js"],
      "run_at": "document_idle"
    }
  ]
}
