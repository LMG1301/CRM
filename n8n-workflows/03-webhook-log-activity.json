{
  "name": "Boost CRM - Webhook Log Activity",
  "nodes": [
    {
      "parameters": {
        "path": "boost-crm-activity",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook",
      "name": "Webhook - Receive Activity",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "boost-crm-activity"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.SUPABASE_URL}}/rest/v1/activities",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "={{$env.SUPABASE_ANON_KEY}}" },
            { "name": "Content-Type", "value": "application/json" },
            { "name": "Prefer", "value": "return=representation" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prospect_id\": \"{{ $json.body.prospect_id }}\",\n  \"type\": \"{{ $json.body.type }}\",\n  \"content\": \"{{ $json.body.content }}\",\n  \"metadata\": {{ JSON.stringify($json.body.metadata || {}) }}\n}"
      },
      "id": "supabase-insert",
      "name": "Supabase - Create Activity",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "options": {
          "responseCode": 200
        },
        "respondWith": "json",
        "responseBody": "={ \"success\": true, \"activity\": {{ JSON.stringify($json) }} }"
      },
      "id": "respond",
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [440, 0]
    }
  ],
  "connections": {
    "Webhook - Receive Activity": { "main": [[{ "node": "Supabase - Create Activity", "type": "main", "index": 0 }]] },
    "Supabase - Create Activity": { "main": [[{ "node": "Respond OK", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "boost-crm" }]
}
