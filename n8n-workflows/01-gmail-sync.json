      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "q": "newer_than:1d"
        },
        "options": {}
      },
      "id": "gmail-fetch",
      "name": "Gmail - Fetch Recent",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [220, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\nconst MY_EMAIL = 'louis.matar.gueye@gmail.com';\n\nfor (const item of items) {\n  const msg = item.json;\n  \n  const fromRaw = msg.from || msg.From || '';\n  const toRaw = msg.to || msg.To || '';\n  const subject = msg.subject || msg.Subject || '';\n  \n  const headers = msg.payload?.headers || [];\n  const getHeader = (name) => {\n    const h = headers.find(h => h.name?.toLowerCase() === name.toLowerCase());\n    return h ? h.value : '';\n  };\n  \n  const fromFinal = fromRaw || getHeader('From');\n  const toFinal = toRaw || getHeader('To');\n  const subjectFinal = subject || getHeader('Subject');\n  \n  const fromMatch = fromFinal.match(/<(.+?)>/);\n  const toMatch = toFinal.match(/<(.+?)>/);\n  const from = fromMatch ? fromMatch[1] : fromFinal;\n  const to = toMatch ? toMatch[1] : toFinal;\n  \n  const direction = from.toLowerCase().includes(MY_EMAIL.toLowerCase()) ? 'sent' : 'received';\n  \n  const rawLabels = msg.labelIds || msg.labels || [];\n  const labels = rawLabels.map(l => typeof l === 'object' ? l.id || l.name : l);\n  \n  let bodyHtml = msg.html || msg.textHtml || '';\n  let bodyText = msg.text || msg.textPlain || '';\n  \n  results.push({\n    json: {\n      gmail_message_id: msg.id,\n      gmail_thread_id: msg.threadId,\n      subject: subjectFinal,\n      from_email: from,\n      to_email: to,\n      body_preview: (msg.snippet || '').substring(0, 500),\n      body_html: bodyHtml.substring(0, 50000),\n      body_text: bodyText.substring(0, 10000),\n      direction: direction,\n      labels: labels,\n      is_read: !labels.includes('UNREAD'),\n      gmail_date: msg.date ? new Date(msg.date).toISOString() : new Date(parseInt(msg.internalDate || Date.now())).toISOString()\n    }\n  });\n}\n\nreturn results;"
      },
