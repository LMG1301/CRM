      "id": "find-prospect",
      "name": "Find Prospect by Email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "jsCode": "const prospects = $input.first().json;\nconst emailData = $('Parse Email').first().json;\n\nconst results = [];\n\n// 1. Always upsert the email\nresults.push({\n  json: {\n    action: 'upsert_email',\n    data: emailData.email_data\n  }\n});\n\n// 2. If prospect found, create activity\nif (Array.isArray(prospects) && prospects.length > 0) {\n  const prospect = prospects[0];\n  const type = emailData.direction === 'sent' ? 'email_sent' : 'email_received';\n  results.push({\n    json: {\n      action: 'create_activity',\n      data: {\n        prospect_id: prospect.id,\n        type: type,\n        content: emailData.subject,\n        metadata: {\n          source: 'gmail_sync',\n          gmail_message_id: emailData.email_data.gmail_message_id,\n          from: emailData.email_data.from_email,\n          to: emailData.email_data.to_email,\n          subject: emailData.subject\n        }\n      }\n    }\n  });\n  \n  // 3. Update prospect last contact date\n  results.push({\n    json: {\n      action: 'update_prospect',\n      prospect_id: prospect.id,\n      data: {\n        date_dernier_contact: new Date().toISOString().split('T')[0]\n      }\n    }\n  });\n}\n\nreturn results;"
      },
      "id": "build-actions",
      "name": "Build Actions",
      "type": "n8n-nodes-base.code",
