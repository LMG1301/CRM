      "id": "gmail-trigger",
      "name": "Gmail Trigger - New Email",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1.2,
      "position": [0, 0],
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const msg = $input.first().json;\nconst MY_EMAIL = 'louis.matar.gueye@gmail.com';\n\n// n8n Gmail trigger returns resolved fields at top level\nconst fromRaw = msg.from || msg.From || '';\nconst toRaw = msg.to || msg.To || '';\nconst subject = msg.subject || msg.Subject || '(Sans objet)';\n\n// Also check payload.headers as fallback\nconst headers = msg.payload?.headers || [];\nconst getHeader = (name) => {\n  const h = headers.find(h => h.name?.toLowerCase() === name.toLowerCase());\n  return h ? h.value : '';\n};\n\nconst fromFinal = fromRaw || getHeader('From');\nconst toFinal = toRaw || getHeader('To');\nconst subjectFinal = subject || getHeader('Subject') || '(Sans objet)';\n\n// Extract email from \"Name <email>\" format\nconst fromMatch = fromFinal.match(/<(.+?)>/);\nconst toMatch = toFinal.match(/<(.+?)>/);\nconst from = fromMatch ? fromMatch[1] : fromFinal;\nconst to = toMatch ? toMatch[1] : toFinal;\n\nconst direction = from.toLowerCase().includes(MY_EMAIL.toLowerCase()) ? 'sent' : 'received';\nconst contactEmail = direction === 'sent' ? to : from;\n\n// Labels: handle both string array and object array\nconst rawLabels = msg.labelIds || msg.labels || [];\nconst labels = rawLabels.map(l => typeof l === 'object' ? l.id || l.name : l);\n\nreturn [{\n  json: {\n    email_data: {\n      gmail_message_id: msg.id,\n      gmail_thread_id: msg.threadId,\n      subject: subjectFinal,\n      from_email: from,\n      to_email: to,\n      body_preview: (msg.snippet || '').substring(0, 500),\n      direction,\n      labels: labels,\n      is_read: !labels.includes('UNREAD'),\n      gmail_date: msg.date ? new Date(msg.date).toISOString() : new Date(parseInt(msg.internalDate || Date.now())).toISOString()\n    },\n    contact_email: contactEmail,\n    direction,\n    subject: subjectFinal\n  }\n}];"
      },
      "id": "parse-email",
      "name": "Parse Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://qbypfqpwrrtzntxgouww.supabase.co/rest/v1/prospects?or=(email.eq.{{ $json.contact_email }},email_pro.eq.{{ $json.contact_email }})&limit=1",
        "authentication": "noAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "apikey", "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFieXBmcXB3cnJ0em50eGdvdXd3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3MjcyNTMsImV4cCI6MjA4ODMwMzI1M30.qKwr_DlKlrXp3D3j28uXh0W_6GtN8LLNcBjZWw_8YeA" },
            { "name": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFieXBmcXB3cnJ0em50eGdvdXd3Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzI3MjcyNTMsImV4cCI6MjA4ODMwMzI1M30.qKwr_DlKlrXp3D3j28uXh0W_6GtN8LLNcBjZWw_8YeA" }
          ]
        }
